---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-10 flex h-16 items-center justify-between border-b border-gray-100 bg-white px-6 dark:border-olive-800 dark:bg-olive-950"
>
  <a
    href="/"
    class="font-sans text-xl font-bold tracking-tight text-gray-900 dark:text-olive-100"
    >JT</a
  >

  <nav
    class="hidden items-center gap-8 text-sm text-gray-600 md:flex dark:text-olive-400"
  >
    <a
      href="/"
      class={`transition-colors hover:text-gray-900 dark:hover:text-olive-100 ${pathname === "/" ? "underline underline-offset-4" : ""}`}
      >Over</a
    >
    <a
      href="/feed"
      class={`transition-colors hover:text-gray-900 dark:hover:text-olive-100 ${pathname === "/feed" ? "underline underline-offset-4" : ""}`}
      >Feed</a
    >
    <a
      href="mailto:jeroen@trines.info"
      class="border border-black bg-transparent px-3 py-1 font-mono text-xs tracking-wider text-black uppercase no-underline transition-colors duration-100 hover:bg-black hover:text-white dark:border-transparent dark:bg-amber-100 dark:text-black dark:hover:bg-emerald-500"
      >mail ↗</a
    >
  </nav>

  <button
    popovertarget="nav-drawer"
    class="hamburger-btn -mr-2 flex h-10 w-10 items-center justify-center rounded-lg text-gray-700 transition-colors hover:bg-gray-100 md:hidden dark:text-olive-300 dark:hover:bg-olive-800"
    aria-label="Menu openen"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="4" y1="6" x2="20" y2="6"></line>
      <line x1="4" y1="12" x2="20" y2="12"></line>
      <line x1="4" y1="18" x2="20" y2="18"></line>
    </svg>
  </button>
</header>

<div id="nav-drawer" popover="auto" aria-label="Navigatie">
  <div class="flex justify-end p-4 pb-2">
    <button
      popovertarget="nav-drawer"
      popovertargetaction="hide"
      class="flex h-10 w-10 items-center justify-center rounded-lg text-gray-700 transition-colors hover:bg-gray-100 dark:text-olive-300 dark:hover:bg-olive-800"
      aria-label="Menu sluiten"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <nav class="flex flex-col gap-1 px-4">
    <a
      href="/"
      class={`rounded-lg px-4 py-3 text-gray-700 transition-colors hover:bg-gray-50 hover:text-gray-900 dark:text-olive-300 dark:hover:bg-olive-800 dark:hover:text-olive-100 ${pathname === "/" ? "underline underline-offset-4" : ""}`}
      >Over</a
    >
    <a
      href="/feed"
      class={`rounded-lg px-4 py-3 text-gray-700 transition-colors hover:bg-gray-50 hover:text-gray-900 dark:text-olive-300 dark:hover:bg-olive-800 dark:hover:text-olive-100 ${pathname === "/feed" ? "underline underline-offset-4" : ""}`}
      >Feed</a
    >
  </nav>
  <div class="fixed right-6 bottom-8">
    <a
      href="mailto:jeroen@trines.info"
      class="border border-black bg-transparent px-3 py-1 font-mono text-xs tracking-wider text-black uppercase no-underline transition-colors duration-100 hover:bg-black hover:text-white dark:border-transparent dark:bg-amber-100 dark:text-black dark:hover:bg-emerald-500"
      >mail ↗</a
    >
  </div>
</div>

<style>
  .hamburger-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  #nav-drawer {
    /* Override popover UA defaults */
    position: fixed;
    inset: 0 0 0 auto;
    margin: 0;
    padding: 0;
    border: none;
    width: min(320px, 85vw);
    height: 100dvh;
    background: white;
    box-shadow: -4px 0 32px rgb(0 0 0 / 0.1);

    /* Closed (base) state — where the exit transition ends */
    transform: translateX(100%);
    opacity: 0;

    transition-property: transform, opacity, overlay, display;
    transition-duration: 0.3s;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-behavior: allow-discrete;
  }

  #nav-drawer:popover-open {
    transform: translateX(0);
    opacity: 1;
  }

  /* Where the enter transition starts */
  @starting-style {
    #nav-drawer:popover-open {
      transform: translateX(100%);
      opacity: 0;
    }
  }

  @media (prefers-color-scheme: dark) {
    #nav-drawer {
      background: var(--color-olive-950);
      box-shadow: -4px 0 32px rgb(0 0 0 / 0.4);
    }
  }

  #nav-drawer::backdrop {
    background: rgb(0 0 0 / 0%);
    backdrop-filter: blur(0px);

    transition-property: display, overlay, background-color, backdrop-filter;
    transition-duration: 0.3s;
    transition-timing-function: ease;
    transition-behavior: allow-discrete;
  }

  #nav-drawer:popover-open::backdrop {
    background: rgb(0 0 0 / 25%);
    backdrop-filter: blur(2px);
  }

  @starting-style {
    #nav-drawer:popover-open::backdrop {
      background: rgb(0 0 0 / 0%);
      backdrop-filter: blur(0px);
    }
  }
</style>
